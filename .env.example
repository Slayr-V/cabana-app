# Copy this to .env and fill in your project's values (Supabase dashboard →
# Project Settings → API). Both are safe to ship in the client bundle — the
# anon key only ever acts within what RLS allows.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
